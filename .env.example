# Lovable Cloud (Supabase) — auto-managed values are written to .env on deploy.
# Do not commit real secrets to source control.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Winerim API + restaurant context
VITE_WINERIM_API_URL=https://app.winerim.com
VITE_WINERIM_RESTAURANT_UUID=00000000-0000-0000-0000-000000000001
VITE_WINERIM_STORE_URL=https://web.winerim.com

# Auth email redirect origin used by signup confirmation and password reset
# emails on native (Capacitor) builds. On web the app uses window.location.origin.
# Production MUST be set in Lovable Project Settings → Environment Variables
# to ensure the email link opens the right host.
VITE_AUTH_REDIRECT_ORIGIN=https://winerim.wine

# Optional fallbacks (used only if VITE_AUTH_REDIRECT_ORIGIN is missing)
# VITE_MATCHRIM_WEB_URL=https://matchrim.winerim.wine
# VITE_WINERIM_APP_URL=https://winerim.wine
